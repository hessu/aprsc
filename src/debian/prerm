#!/bin/sh
set -e

action="$1"
version="$2"

if [ "$action" = "upgrade" ]; then
	exit 0
fi

# shut it down
if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
	units=`systemctl list-units --no-legend --plain --state=active 'aprsc.service' 'aprsc@*.service' 2>/dev/null | awk '{ print $1 }'`
	if [ -n "$units" ]; then
		deb-systemd-invoke stop $units || true
	fi
elif [ -x "/etc/init.d/aprsc" ]; then
	if [ -x "`which invoke-rc.d 2>/dev/null`" ]; then
		invoke-rc.d aprsc stop || exit $?
	else
		/etc/init.d/aprsc stop || exit $?
	fi
fi

# delete device files from chroot
rm -f /opt/aprsc/dev/*

# unmount bind mounts
umount /opt/aprsc/lib 2>/dev/null || true
umount /opt/aprsc/lib64 2>/dev/null || true
umount /opt/aprsc/usr/lib 2>/dev/null || true
umount /opt/aprsc/usr/lib64 2>/dev/null || true
